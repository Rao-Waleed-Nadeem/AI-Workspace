# Copy this file to .env and replace every
# placeholder with real values.
# Never commit .env.

DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/ai_workspace

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ai_workspace

GROQ_API_KEY=your_groq_api_key_here
MODEL_NAME=your_groq_text_model_here
VISION_MODEL_NAME=your_groq_vision_model_here

JWT_SECRET=replace_with_a_long_random_secret

# Optional embedding/image settings
HF_TOKEN=
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Application configuration
LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=60

AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60